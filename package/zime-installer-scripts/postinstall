#!/bin/zsh
# SPDX-License-Identifier: GPL-3.0-or-later
set -euo pipefail
# Installer stages inert payload only. ZIP and PKG use the same publisher.
[[ "$(/usr/bin/id -u)" != 0 ]] || {
  print -u2 "ZIME: choose Install for me only; do not run the installer as root."
  exit 1
}
version="$(<"${0:A:h}/version")"
[[ "${version}" =~ '^[0-9]+\.[0-9]+\.[0-9]+$' ]] || exit 1
# Both source staging and destination are derived from getpwuid() by the
# shared helper; Installer's HOME and positional paths are not trusted.
helper="${0:A:h}/zime-install-helper"
[[ -x "${helper}" && ! -L "${helper}" ]] || exit 1
/usr/bin/codesign --verify --strict "${helper}"
exec "${helper}" install-staged "${version}"
