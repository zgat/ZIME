#!/bin/zsh
# SPDX-License-Identifier: GPL-3.0-or-later
# Core-only updates preserve the installed language-data ABI and learning.
set -euo pipefail
script_dir="${0:A:h}"
[[ "$#" -le 1 ]] || { print -u2 "usage: ./update-zime-app [APP]"; exit 2; }
helper="${script_dir}/zime-install-helper"
[[ -x "${helper}" && ! -L "${helper}" ]] || exit 1
/usr/bin/codesign --verify --strict "${helper}"
exec "${helper}" update "${1:-${script_dir}/ZIME.app}"
