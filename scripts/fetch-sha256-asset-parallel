#!/usr/bin/env bash

set -euo pipefail

fail_asset() {
  echo "fetch-sha256-asset-parallel: $1" >&2
  exit 1
}

[[ "$#" -eq 4 ]] || fail_asset "usage: URL BYTES SHA256 OUTPUT"
url="$1"
expected_bytes="$2"
expected_sha256="$3"
output="$4"
parts="${LINNET_ASSET_DOWNLOAD_PARTS:-16}"

[[ "${url}" =~ ^https://[^[:space:]]+$ ]] || fail_asset "URL must use HTTPS"
[[ "${expected_bytes}" =~ ^[1-9][0-9]*$ ]] || fail_asset "byte count is invalid"
[[ "${expected_sha256}" =~ ^[0-9a-f]{64}$ ]] || fail_asset "digest is invalid"
[[ "${parts}" =~ ^[0-9]+$ && "${parts}" -ge 2 && "${parts}" -le 64 ]] ||
  fail_asset "LINNET_ASSET_DOWNLOAD_PARTS must be between 2 and 64"
[[ "${output}" == /* && ! -e "${output}" && ! -L "${output}" ]] ||
  fail_asset "output must be one new absolute path"
output_parent="$(cd "$(dirname "${output}")" && pwd -P)"
[[ "${output}" == "${output_parent}/$(basename "${output}")" ]] ||
  fail_asset "output is not canonical"

work="$(mktemp -d "${output_parent}/.$(basename "${output}").parallel.XXXXXX")"
download="${work}/download"
pids=()
cleanup_asset() {
  local status=$?
  trap - EXIT INT TERM HUP
  if ((${#pids[@]})); then
    kill "${pids[@]}" 2>/dev/null || true
    wait "${pids[@]}" 2>/dev/null || true
  fi
  case "${work}" in
    "${output_parent}/.$(basename "${output}").parallel."??????)
      chmod -R u+w "${work}" 2>/dev/null || true
      find "${work}" -depth -delete 2>/dev/null || status=1
      ;;
    *) status=1 ;;
  esac
  exit "${status}"
}
trap cleanup_asset EXIT INT TERM HUP

chunk_size="$(((expected_bytes + parts - 1) / parts))"
for ((index = 0; index < parts; index += 1)); do
  start="$((index * chunk_size))"
  ((start < expected_bytes)) || break
  end="$((start + chunk_size - 1))"
  ((end < expected_bytes)) || end="$((expected_bytes - 1))"
  part="${work}/part.$(printf '%03d' "${index}")"
  expected_part_bytes="$((end - start + 1))"
  (
    curl --fail --silent --show-error --proto '=https' --connect-timeout 30 --max-time 900 \
      -H 'User-Agent: ZIME-locked-build-asset' --range "${start}-${end}" \
      --output "${part}" "${url}"
    [[ "$(stat -f %z "${part}")" == "${expected_part_bytes}" ]]
  ) &
  pids+=("$!")
done
for pid in "${pids[@]}"; do
  wait "${pid}" || fail_asset "one ranged asset request failed"
done
pids=()

: >"${download}"
for ((index = 0; index < parts; index += 1)); do
  part="${work}/part.$(printf '%03d' "${index}")"
  [[ -f "${part}" ]] || break
  /bin/cat "${part}" >>"${download}"
done
[[ "$(stat -f %z "${download}")" == "${expected_bytes}" ]] ||
  fail_asset "asset byte count differs from the lock"
actual_sha256="$(shasum -a 256 "${download}" | awk '{print $1}')"
[[ "${actual_sha256}" == "${expected_sha256}" ]] ||
  fail_asset "asset digest differs from the lock"
mv "${download}" "${output}"
echo "Locked parallel HTTPS asset: PASS (${expected_bytes} bytes, ${actual_sha256})"
