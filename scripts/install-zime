#!/bin/zsh
# SPDX-License-Identifier: GPL-3.0-or-later
set -euo pipefail
script_dir="${0:A:h}"
[[ "$#" -le 1 ]] || { print -u2 "usage: ./install-zime [APP]"; exit 2; }
helper="${script_dir}/zime-install-helper"
[[ -x "${helper}" && ! -L "${helper}" ]] || exit 1
/usr/bin/codesign --verify --strict "${helper}"
exec "${helper}" install "${1:-${script_dir}/ZIME.app}" "${script_dir}/ZIME-Data"
