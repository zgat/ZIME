#!/usr/bin/env ruby
# SPDX-License-Identifier: GPL-3.0-or-later
# Deterministic, offline CC-CEDICT projection. The data retains CC BY-SA 4.0.
require 'zlib'
require 'json'
require 'digest'
require 'open3'
require 'tempfile'
require 'tmpdir'

abort 'usage: build-zime-lexicon CEDICT.txt.gz OUTPUT.sqlite3' unless ARGV.length == 2
input, output = ARGV
abort 'refusing to overwrite output' if File.exist?(output)
entries = Hash.new { |h, k| h[k] = [] }
source_rows = []
source_count = 0
Zlib::GzipReader.open(input) do |gzip|
  gzip.each_line do |line|
    line = line.force_encoding('UTF-8').strip
    next if line.empty? || line.start_with?('#')
    match = /\A(\S+) (\S+) \[([^\]]+)\] \/(.*)\/\z/.match(line)
    abort "invalid CC-CEDICT row #{source_count + 1}" unless match
    traditional, simplified, pinyin, definition = match.captures
    source_count += 1
    # Keep every source sense, including references, classifiers and ordinary
    # English beginning with "see". Interpretation belongs to the shared parser.
    senses = definition.split('/', -1)
    priority = pinyin.match?(/\A[A-Z]/) ? 1 : 0
    # Preserve the source identity. A shared simplified spelling does not make
    # two traditional headwords the same entry (e.g. 你/妳 and 發/髮).
    source_rows << [source_count, traditional, simplified, pinyin, priority, JSON.generate(senses)]
    senses.each do |sense|
      # Reverse only complete short English glosses, never fragments of a
      # definition or romanized Chinese references.
      next unless sense.match?(/\A[a-z][a-z '-]{1,47}\z/) && sense.split.length <= 5
      entries["en\t#{sense}"] << [simplified.length + priority * 100, simplified]
    end
  end
end
Tempfile.create(['zime-lexicon-', '.tsv']) do |tsv|
  Tempfile.create(['zime-source-entries-', '.tsv']) do |source_tsv|
    source_rows.each { |row| source_tsv.puts row.join("\t") }
    source_tsv.flush
    entries.keys.sort.each do |key|
      values = entries.fetch(key).sort_by { |priority, _| priority }.map(&:last).uniq.first(6)
      tsv.puts "#{key}\t#{JSON.generate(values)}"
    end
    tsv.flush
    sql = <<~SQL
      .bail on
      PRAGMA journal_mode=OFF;
      CREATE TABLE entries(language TEXT NOT NULL, term TEXT NOT NULL, senses TEXT NOT NULL, PRIMARY KEY(language, term)) WITHOUT ROWID;
      .mode tabs
      .import "#{tsv.path}" entries
      CREATE TABLE source_entries(id INTEGER PRIMARY KEY, traditional TEXT NOT NULL, simplified TEXT NOT NULL, pinyin TEXT NOT NULL, priority INTEGER NOT NULL, senses TEXT NOT NULL);
      .import "#{source_tsv.path}" source_entries
      CREATE INDEX source_traditional ON source_entries(traditional);
      CREATE INDEX source_simplified ON source_entries(simplified);
      CREATE TABLE metadata(key TEXT PRIMARY KEY, value TEXT NOT NULL) WITHOUT ROWID;
      INSERT INTO metadata VALUES('source_entries','#{source_count}'),('source_sha256','#{Digest::SHA256.file(input).hexdigest}'),('license','CC-BY-SA-4.0');
      PRAGMA user_version=3;
      VACUUM;
      PRAGMA integrity_check;
    SQL
    stdout, stderr, status = Open3.capture3('/usr/bin/sqlite3', output, stdin_data: sql)
    abort stderr unless status.success? && stdout.lines.last&.strip == 'ok'
  end
end
root = File.expand_path('..', __dir__)
Dir.mktmpdir('zime-lexicon-projection-') do |scratch|
  builder = File.join(scratch, 'project')
  projections = File.join(scratch, 'annotations.tsv')
  compile = ['/usr/bin/xcrun', 'swiftc', '-O', '-warnings-as-errors', '-parse-as-library',
    '-module-cache-path', File.join(scratch, 'modules'),
    File.join(root, 'sources/ZIMELocalLexicon.swift'), File.join(root, 'tools/ZIMELexiconProjectionBuilder.swift'), '-o', builder]
  stdout, stderr, status = Open3.capture3(*compile)
  abort "#{stdout}\n#{stderr}" unless status.success?
  stdout, stderr, status = Open3.capture3(builder, File.expand_path(output), projections)
  abort "#{stdout}\n#{stderr}" unless status.success?
  puts stdout
  sql = <<~SQL
    .bail on
    CREATE TABLE annotations(term TEXT PRIMARY KEY, all_senses TEXT NOT NULL, mainland TEXT, traditional_regions TEXT) WITHOUT ROWID;
    .mode tabs
    .import "#{projections}" annotations
    UPDATE annotations SET mainland=NULL WHERE mainland='';
    UPDATE annotations SET traditional_regions=NULL WHERE traditional_regions='';
    INSERT INTO metadata VALUES('projection_revision','3');
    VACUUM;
    PRAGMA integrity_check;
  SQL
  stdout, stderr, status = Open3.capture3('/usr/bin/sqlite3', output, stdin_data: sql)
  abort stderr unless status.success? && stdout.lines.last&.strip == 'ok'
end
puts "CC-CEDICT index v3: #{source_count} lossless source entries, #{entries.count} reverse English heads; #{output}"
